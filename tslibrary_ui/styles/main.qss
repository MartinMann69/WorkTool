QMainWindow#mainWindow, QWidget#mainContent { background: #181b18; }
QWidget#workplacePage { background: transparent; }
QTabWidget#workplaceTabs::pane { border: none; border-top: 1px solid #38412f; }
QTabBar::tab { background: transparent; color: #9fa98e; border: none; border-bottom: 2px solid transparent; padding: 15px 26px 14px 20px; margin-right: 12px; font-size: 12px; }
QTabBar::tab:selected { color: #ede4d1; border-bottom: 2px solid #c9b18c; }
QTabBar::tab:hover { color: #e2d8c3; background: #20271d; }
QTabBar::tab:focus { color: #eee0c4; }
QLabel#workplaceEyebrow { color: #a5aa91; font-size: 10px; letter-spacing: 1.8px; }
QLabel#workplaceHeading { color: #eee8dc; font-family: Georgia; font-size: 38px; }
QLabel#workplaceDescription { color: #abb39d; font-size: 12px; }
QLabel#workplaceMuted { color: #a4af95; font-size: 12px; }
QLabel#workplaceEmptyHeading { color: #e6dcc7; font-family: Georgia; font-size: 27px; }
QLineEdit#workplaceSearch { color: #e9e5d5; background: #20261d; border: 1px solid #414b35; border-radius: 7px; padding: 0 14px; font-size: 12px; }
QLineEdit#workplaceSearch:focus { border-color: #b9a27b; }
QFrame#workplaceEmpty { background: #1b2219; border: 1px solid #35402d; border-radius: 9px; }
QPushButton#workplaceSecondary { background: transparent; color: #c7cbb6; border: 1px solid #48543a; border-radius: 6px; padding: 0 14px; font-size: 12px; }
QPushButton#workplaceSecondary:hover, QPushButton#workplaceSecondary:focus { background: #2c3525; border-color: #b5a079; }
QPushButton#workplacePrimary { background: #c9b18c; color: #20251c; border: 1px solid #c9b18c; border-radius: 6px; padding: 0 16px; font-size: 12px; font-weight: 600; }
QPushButton#workplacePrimary:hover, QPushButton#workplacePrimary:focus { background: #dfc5a0; border-color: #f0d8b2; }
QPushButton#workplacePrimary:disabled { background: #343f2b; color: #899677; border-color: #414d36; }
QPushButton#workplaceSecondary:disabled { color: #748066; border-color: #35422d; }
QPushButton#workplaceLink { color: #cbb58e; background: transparent; border: none; padding: 0 1px; font-size: 12px; }
QPushButton#workplaceLink:hover, QPushButton#workplaceLink:focus { color: #ebd7b3; text-decoration: underline; }
QStatusBar { background: #181b18; color: #b5c5a2; font-size: 12px; border: none; }
QStatusBar::item { border: none; }
QFrame#selectionSidebar { background: #1d251a; border: 1px solid #3e4a33; border-radius: 9px; }
QLabel#selectionHeading { color: #e4e3d1; font-family: Georgia; font-size: 25px; }
QLabel#selectionCount { color: #d7e2c8; background: #36442c; border: 1px solid #536444; border-radius: 13px; font-size: 12px; padding: 0 5px; }
QListView#selectionList { background: transparent; border: none; outline: none; padding: 0; }
QListView#selectionList::item { border: none; }
